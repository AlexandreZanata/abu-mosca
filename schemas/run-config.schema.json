{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossconnectome-mu.invalid/schemas/run-config.schema.json",
  "title": "Configuração de experimento (R04)",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "seed", "params"],
  "properties": {
    "experiment": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "repeats": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "notes": {"type": "string"}
  }
}
