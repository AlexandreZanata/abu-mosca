{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossconnectome-mu.invalid/schemas/predictions.schema.json",
  "title": "Pacote de predições por ID opaco (R06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "seed", "gallery", "queries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "seed": {"type": "integer", "minimum": 0},
    "gallery": {
      "type": "object",
      "required": ["nodes", "types"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "types": {"type": "integer", "minimum": 1}
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ranked"],
        "properties": {
          "id": {"type": "string", "pattern": "^q[0-9a-f]{16}$"},
          "ranked": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "score"],
              "properties": {
                "id": {"type": "string", "pattern": "^g[0-9a-f]{16}$"},
                "score": {"type": "number"}
              }
            }
          },
          "rejected": {"type": "boolean"}
        }
      }
    }
  }
}
