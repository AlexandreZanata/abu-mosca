{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossconnectome-mu.invalid/schemas/manifest.schema.json",
  "title": "Manifesto de proveniência de arquivo de dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "release", "source_page", "license", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "source_page": {"type": "string", "pattern": "^(https://|10\\.)"},
    "license": {
      "type": "string",
      "enum": ["CC-BY-4.0", "CC-BY-4.0-restricted", "CC-BY-4.0-annotations-unclear"]
    },
    "notes": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "url", "bytes", "sha256", "accessed_at"],
        "properties": {
          "path": {"type": "string", "pattern": "^data/raw/[A-Za-z0-9._/-]+$"},
          "url": {"type": "string", "pattern": "^https://[^@\\s]+$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "md5_official": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
          "accessed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
