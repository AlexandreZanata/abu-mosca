{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossconnectome-mu.invalid/schemas/graph.schema.json",
  "title": "Grafo canônico CrossConnectome-µ (H01)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "graph", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "release", "license", "source_files", "adapter", "created_at"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "config_sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directed", "weighted", "allow_self_loops", "aggregation", "threshold"],
      "properties": {
        "directed": {"type": "boolean"},
        "weighted": {"type": "boolean"},
        "weight_units": {"type": ["string", "null"]},
        "allow_self_loops": {"type": "boolean"},
        "aggregation": {"enum": ["none", "sum"]},
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight_min", "rule"],
          "properties": {
            "weight_min": {"type": ["integer", "null"], "minimum": 0},
            "rule": {"enum": ["keep", "drop_below"]}
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attributes", "missing"],
        "properties": {
          "id": {"type": "string", "pattern": "^n[0-9a-f]{16}$"},
          "attributes": {"type": "object"},
          "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "weight", "attributes", "missing"],
        "properties": {
          "source": {"type": "string", "pattern": "^n[0-9a-f]{16}$"},
          "target": {"type": "string", "pattern": "^n[0-9a-f]{16}$"},
          "weight": {"type": ["number", "null"], "minimum": 0},
          "attributes": {"type": "object"},
          "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
