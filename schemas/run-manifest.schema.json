{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossconnectome-mu.invalid/schemas/run-manifest.schema.json",
  "title": "RUN-MANIFEST (R04)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "tool",
    "config",
    "config_sha256",
    "code",
    "environment",
    "seeds",
    "resources",
    "outputs",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "created_at": {"type": "string"},
    "tool": {"type": "string"},
    "config": {"type": "object"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code": {
      "type": "object",
      "required": ["git_commit", "git_dirty", "dirty_diff_sha256"],
      "properties": {
        "git_commit": {"type": "string"},
        "git_dirty": {"type": "boolean"},
        "dirty_diff_sha256": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "implementation", "platform", "packages"],
      "properties": {
        "python": {"type": "string"},
        "implementation": {"type": "string"},
        "platform": {"type": "string"},
        "packages": {"type": "object"}
      }
    },
    "seeds": {
      "type": "object",
      "required": ["master", "derived"],
      "properties": {
        "master": {"type": "integer"},
        "derived": {"type": "object"}
      }
    },
    "resources": {
      "type": "object",
      "required": ["wall_s", "peak_rss_mib", "disk_free_gib"],
      "properties": {
        "wall_s": {"type": "number"},
        "peak_rss_mib": {"type": "number"},
        "disk_free_gib": {"type": "number"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^outputs/"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "status": {"const": "completed"}
  }
}
